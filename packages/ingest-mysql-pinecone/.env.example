# MySQL server holding the redacted Desk + Skylight databases (read-only user recommended).
# No database in the path is needed: the config's SQL qualifies every table
# (desk.projects, skylight.cards), so one connection reads both.
# Sources on a different server can set their own "connectionEnv" in the config.
MYSQL_URL=mysql://user:password@127.0.0.1:3306

# Only needed for a real run (not --inspect / --dry-run).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Optional; overrides the config's "namespace".
PINECONE_NAMESPACE=

OPENAI_API_KEY=
# Optional; must match the Pinecone index dimension (text-embedding-3-small = 1536).
OPENAI_EMBEDDING_MODEL=
