PORT=3004
LOG_LEVEL=info

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Path to a directory of snapshot JSON tables (see packages/agent-assistant/data/snapshot/valid for the shape).
SNAPSHOT_DIR=../../packages/agent-assistant/data/snapshot/valid
AS_OF_DATE=2026-09-10

# Gates POST /chat and POST /sessions/:id/reset — the UI asks for this once and stores it in localStorage.
DEMO_TOKEN=

MAX_TOOL_STEPS=6
MODEL_TIMEOUT_MS=15000
MAX_TOKENS_PER_REQUEST=1024

RATE_LIMIT_PER_IP_PER_MINUTE=20
RATE_LIMIT_PER_SESSION_PER_MINUTE=10
# A proxy for a daily spend cap: AIProvider doesn't expose token usage/pricing,
# so this caps the number of model calls per UTC day instead of real cost.
DAILY_MODEL_CALL_CAP=500
