PORT=3004
LOG_LEVEL=info

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Structured mode (default): a directory of snapshot JSON tables — see
# packages/agent-assistant/data/snapshot/valid for the shape. Required unless
# PINECONE_INDEX_NAME (below) is set.
SNAPSHOT_DIR=../../packages/agent-assistant/data/snapshot/valid
AS_OF_DATE=2026-09-10

# Pinecone-search mode: swaps the structured query layer for semantic search
# over an existing MySQL->Pinecone index (see packages/ingest-mysql-pinecone).
# Leave PINECONE_INDEX_NAME unset to stay in structured mode; when set,
# PINECONE_API_KEY becomes required too, and SNAPSHOT_DIR/AS_OF_DATE are
# ignored. This service only *queries* the index — it doesn't populate it;
# run `pnpm --filter @gracesoft-sentinel/ingest-mysql-pinecone run sync` first.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=desk-skylight

MAX_TOOL_STEPS=6
MODEL_TIMEOUT_MS=15000
MAX_TOKENS_PER_REQUEST=1024
# A proxy for a daily spend cap: AIProvider doesn't expose token usage/pricing,
# so this caps the number of model calls per UTC day instead of real cost.
DAILY_MODEL_CALL_CAP=500
# Per-chatter flood floor (in-memory — this service has no Redis dependency).
RATE_LIMIT_PER_CHATTER_PER_MINUTE=10

# --- Channels -------------------------------------------------------------
# Any combination can be enabled at once; at least one must be. Each gets
# its own path (register these with each platform):
#   /whatsapp/webhook  /telegram/webhook  /sms/webhook  /slack/webhook
#   /line/webhook      /chat/gracesoft/   /chat/davdevs/
# The old shared /webhook path still works for WhatsApp/Telegram/SMS/Slack/
# LINE (routed by each platform's signature header), so already-registered
# webhook URLs keep working unchanged.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# SMS/MMS via Twilio. SMS_WEBHOOK_URL must be the exact public URL set in
# Twilio (e.g. https://your-host/sms/webhook) — Twilio signs over it.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_URL=

# Slack: point both Event Subscriptions and Interactivity at /slack/webhook;
# subscribe to message.im and app_mention. Bot scopes: chat:write,
# im:history, app_mentions:read, files:read.
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# LINE Messaging API: set the channel's Webhook URL to /line/webhook.
LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Branded browser chats (GraceSoft / Dav/Devs themes). Set
# WEB_CHAT_ACCESS_TOKEN (8+ chars) before exposing either publicly — without
# it anyone with the URL can talk to the (paid) model. The two optional copy
# overrides change the chat header and first message.
WEB_GRACESOFT_ENABLED=false
WEB_DAVDEVS_ENABLED=false
WEB_CHAT_ACCESS_TOKEN=
WEB_CHAT_PRODUCT_NAME=
WEB_CHAT_WELCOME_MESSAGE=
