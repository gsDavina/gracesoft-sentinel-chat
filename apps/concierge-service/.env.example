PORT=3000
LOG_LEVEL=info

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

REDIS_URL=redis://redis:6379
DATABASE_URL=postgres://gracesoft:gracesoft@postgres:5432/gracesoft_sentinel

# Single-tenant mode: path to a JSON file matching @gracesoft-sentinel/core's
# BusinessConfigSchema. See _internal-docs/data/business-config.example.json
# for a real one, built from the actual GraceSoft FAQ blueprint + Singapore
# public holiday data. Resolved relative to this service's own working
# directory at runtime (apps/concierge-service — both `pnpm --filter
# @gracesoft-sentinel/concierge-service start` and the Docker image's
# WORKDIR land there), not the monorepo root, hence "../../".
BUSINESS_CONFIG_PATH=../../_internal-docs/data/business-config.example.json

# Multi-tenant mode (multiple businesses on one deployment): instead of
# BUSINESS_CONFIG_PATH, point this at a directory of per-business config
# files, one per business, each named "<businessChannelId>.json" — the
# WhatsApp phone_number_id or Twilio "To" number that routes an inbound
# message to that business. Each business's faqBlueprintPath must resolve
# into a nested subdirectory (e.g. "./faq-blueprints/<id>.json"), not
# directly inside this directory. Takes precedence over BUSINESS_CONFIG_PATH
# when both are set.
# BUSINESS_CONFIGS_DIR=../../_internal-docs/data/business-configs

# Deployment-wide fallback for how many days ahead a chatter may book or
# reschedule into. Only applies to a business config that doesn't set its
# own `maxBookingHorizonDays` — a business's own value always wins. Unset
# means no deployment-wide default (each business config must set its own
# cap, or none applies).
# DEFAULT_MAX_BOOKING_HORIZON_DAYS=60

# --- Channels -------------------------------------------------------------
# Any combination can be enabled at once; at least one must be. Each gets
# its own path (register these with each platform):
#   /whatsapp/webhook  /telegram/webhook  /sms/webhook  /slack/webhook
#   /line/webhook      /chat/gracesoft/   /chat/davdevs/
# The old shared /webhook path still works for WhatsApp/Telegram/SMS/Slack/
# LINE (routed by each platform's signature header), so already-registered
# webhook URLs keep working unchanged.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# SMS/MMS via Twilio. SMS_WEBHOOK_URL must be the exact public URL set in
# Twilio (e.g. https://your-host/sms/webhook) — Twilio signs over it.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_URL=

# Slack: point both Event Subscriptions and Interactivity at /slack/webhook;
# subscribe to message.im and app_mention. Bot scopes: chat:write,
# im:history, app_mentions:read, files:read.
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# LINE Messaging API: set the channel's Webhook URL to /line/webhook.
LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Branded browser chats (GraceSoft / Dav/Devs themes). Set
# WEB_CHAT_ACCESS_TOKEN (8+ chars) before exposing either publicly — without
# it anyone with the URL can talk to the (paid) model. The two optional copy
# overrides change the chat header and first message.
WEB_GRACESOFT_ENABLED=false
WEB_DAVDEVS_ENABLED=false
WEB_CHAT_ACCESS_TOKEN=
WEB_CHAT_PRODUCT_NAME=
WEB_CHAT_WELCOME_MESSAGE=
