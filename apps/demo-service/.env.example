PORT=3003
LOG_LEVEL=info

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

REDIS_URL=redis://redis:6379
DATABASE_URL=postgres://gracesoft:gracesoft@postgres:5432/gracesoft_sentinel

# Concierge half only — Cook doesn't use a business config. Resolved
# relative to this service's own working directory at runtime (both
# `pnpm --filter @gracesoft-sentinel/demo-service start` and the Docker
# image's WORKDIR land at apps/demo-service), hence "../../".
#
# Point this at a *separate* demo calendar, not the real business one — a
# demo will create real (fake-looking) bookings, which shouldn't land on
# whatever calendar apps/concierge-service is actually using in production.
BUSINESS_CONFIG_PATH=../../_internal-docs/data/business-config.example.json

# Which agent a chatter is talking to before they ever explicitly switch.
# The other one is one command/passphrase away — see composition.ts for
# the exact trigger words ("/concierge"/"concierge", "/cook"/"cook").
DEMO_DEFAULT_AGENT=concierge

# "Mother's Day Edition" (optional): personal recipe retrieval via RAG,
# queried from a Pinecone index, for the Cook half. Leave PINECONE_INDEX_NAME
# unset to disable — Cook's ordinary photo-based flow is unaffected either
# way. When set, PINECONE_API_KEY becomes required too.
#
# This app only *queries* the index — it doesn't populate it. Run
# `pnpm --filter @gracesoft-sentinel/provider-recipe-pinecone run sync`
# (its own env vars: GOOGLE_SERVICE_ACCOUNT_EMAIL/PRIVATE_KEY — reuse the
# ones above — GOOGLE_DRIVE_RECIPES_FOLDER_ID, OPENAI_API_KEY, plus the
# three below) to (re)index a Google Drive folder of personal recipes into
# Pinecone first.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=

# GraceSoft Assistant (feature-flagged, off by default): Q&A over a redacted
# GraceSoft Desk/Skylight snapshot, as a third agent alongside Concierge and
# Cook. Leave ASSISTANT_ENABLED unset/false to leave demo-service exactly as
# it was before this agent existed — nothing else changes. When enabled,
# ASSISTANT_SNAPSHOT_DIR becomes required; see
# packages/agent-assistant/data/snapshot/valid for the fixture's shape, or
# point this at a real redacted export once one exists. Reachable via the
# "/assistant"/"assistant" trigger, or set DEMO_DEFAULT_AGENT=assistant to
# make it the default.
ASSISTANT_ENABLED=false
ASSISTANT_SNAPSHOT_DIR=../../packages/agent-assistant/data/snapshot/valid
ASSISTANT_AS_OF_DATE=2026-09-10
ASSISTANT_MAX_TOOL_STEPS=6
ASSISTANT_MODEL_TIMEOUT_MS=15000
ASSISTANT_MAX_TOKENS_PER_REQUEST=1024

# This app's whole point is demoing multiple services through *one* chat
# window — in practice that means picking exactly one of these two, not
# both. (Both can technically be enabled, mirroring concierge-service/
# cook-service's own env shape, but see server.ts's note on why that's not
# actually useful here — and each needs its own dedicated bot/number,
# distinct from whatever apps/concierge-service or apps/cook-service are
# already using standalone, or you'll steal their webhook traffic.)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
