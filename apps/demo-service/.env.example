PORT=3003
LOG_LEVEL=info

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

REDIS_URL=redis://redis:6379
DATABASE_URL=postgres://gracesoft:gracesoft@postgres:5432/gracesoft_sentinel

# Concierge half only — Cook doesn't use a business config. Resolved
# relative to this service's own working directory at runtime (both
# `pnpm --filter @gracesoft-sentinel/demo-service start` and the Docker
# image's WORKDIR land at apps/demo-service), hence "../../".
#
# Point this at a *separate* demo calendar, not the real business one — a
# demo will create real (fake-looking) bookings, which shouldn't land on
# whatever calendar apps/concierge-service is actually using in production.
BUSINESS_CONFIG_PATH=../../_internal-docs/data/business-config.example.json

# Which agent a chatter is talking to before they ever explicitly switch.
# The other one is one command/passphrase away — see composition.ts for
# the exact trigger words ("/concierge"/"concierge", "/cook"/"cook").
DEMO_DEFAULT_AGENT=concierge

# "Mother's Day Edition" (optional): personal recipe retrieval via RAG,
# queried from a Pinecone index, for the Cook half. Leave PINECONE_INDEX_NAME
# unset to disable — Cook's ordinary photo-based flow is unaffected either
# way. When set, PINECONE_API_KEY becomes required too.
#
# This app only *queries* the index — it doesn't populate it. Run
# `pnpm --filter @gracesoft-sentinel/provider-recipe-pinecone run sync`
# (its own env vars: GOOGLE_SERVICE_ACCOUNT_EMAIL/PRIVATE_KEY — reuse the
# ones above — GOOGLE_DRIVE_RECIPES_FOLDER_ID, OPENAI_API_KEY, plus the
# three below) to (re)index a Google Drive folder of personal recipes into
# Pinecone first.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=

# GraceSoft Assistant (feature-flagged, off by default): Q&A over GraceSoft
# Desk/Skylight data, as a third agent alongside Concierge and Cook. Leave
# ASSISTANT_ENABLED unset/false to leave demo-service exactly as it was
# before this agent existed — nothing else changes. Reachable via the
# "/assistant"/"assistant" trigger, or set DEMO_DEFAULT_AGENT=assistant to
# make it the default.
#
# Two mutually exclusive data modes — set exactly one of the two blocks below:
#
# 1. Structured mode (default): a directory of snapshot JSON tables, queried
#    deterministically. See packages/agent-assistant/data/snapshot/valid for
#    the fixture's shape, or point this at a real redacted export.
ASSISTANT_ENABLED=false
ASSISTANT_SNAPSHOT_DIR=../../packages/agent-assistant/data/snapshot/valid
ASSISTANT_AS_OF_DATE=2026-09-10
ASSISTANT_MAX_TOOL_STEPS=6
ASSISTANT_MODEL_TIMEOUT_MS=15000
ASSISTANT_MAX_TOKENS_PER_REQUEST=1024
#
# 2. Pinecone-search mode: swaps the structured query layer for semantic
#    search over an existing MySQL->Pinecone index (see
#    packages/ingest-mysql-pinecone) — set ASSISTANT_PINECONE_INDEX_NAME and
#    ASSISTANT_SNAPSHOT_DIR/AS_OF_DATE above are ignored. Deliberately
#    separate from the Mother's Day Edition's own PINECONE_* vars above —
#    different index, never conflated. This app only *queries* the index;
#    run `pnpm --filter @gracesoft-sentinel/ingest-mysql-pinecone run sync` first.
ASSISTANT_PINECONE_API_KEY=
ASSISTANT_PINECONE_INDEX_NAME=
ASSISTANT_PINECONE_NAMESPACE=desk-skylight

# --- Channels -------------------------------------------------------------
# Any combination can be enabled at once; at least one must be. Each gets
# its own path (register these with each platform):
#   /whatsapp/webhook  /telegram/webhook  /sms/webhook  /slack/webhook
#   /line/webhook      /chat/gracesoft/   /chat/davdevs/
# The old shared /webhook path still works for WhatsApp/Telegram/SMS/Slack/
# LINE (routed by each platform's signature header), so already-registered
# webhook URLs keep working unchanged.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# SMS/MMS via Twilio. SMS_WEBHOOK_URL must be the exact public URL set in
# Twilio (e.g. https://your-host/sms/webhook) — Twilio signs over it.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_URL=

# Slack: point both Event Subscriptions and Interactivity at /slack/webhook;
# subscribe to message.im and app_mention. Bot scopes: chat:write,
# im:history, app_mentions:read, files:read.
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# LINE Messaging API: set the channel's Webhook URL to /line/webhook.
LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Branded browser chats (GraceSoft / Dav/Devs themes). Set
# WEB_CHAT_ACCESS_TOKEN (8+ chars) before exposing either publicly — without
# it anyone with the URL can talk to the (paid) model. The two optional copy
# overrides change the chat header and first message.
WEB_GRACESOFT_ENABLED=false
WEB_DAVDEVS_ENABLED=false
WEB_CHAT_ACCESS_TOKEN=
WEB_CHAT_PRODUCT_NAME=
WEB_CHAT_WELCOME_MESSAGE=
